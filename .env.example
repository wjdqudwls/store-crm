DB_ROOT_PASSWORD=change-me-root
DB_NAME=crm
DB_USER=crm
DB_PASSWORD=change-me
DB_PORT=3316

# 개인정보 암호화 키 (B1-3). 각각 새로 만든다: openssl rand -base64 32
# 한 번 정하면 바꾸지 않는다 (바꾸면 저장된 전화번호를 읽을 수 없다).
CRYPTO_KEY=change-me-base64-32-bytes
HMAC_KEY=change-me-base64-32-bytes

# 로그인 (B0-3). JWT 시크릿: openssl rand -base64 48 (32바이트 이상)
JWT_SECRET=change-me-at-least-32-bytes-long-secret-value
# 기본 계정의 처음 비밀번호 (8자 이상, 영문+숫자). 운영에서는 쿠버네티스 Secret으로 넣는다.
HQ_INITIAL_PASSWORD=change-me-hq1
STORE_GN01_INITIAL_PASSWORD=change-me-gn011
STORE_HD01_INITIAL_PASSWORD=change-me-hd011
STAFF_INITIAL_PASSWORD=change-me-staff1
